APP_ENV=local
APP_NAME=Public Website
APP_DEBUG=0
APP_DISPLAY_TIMEZONE=Africa/Mogadishu

# Local (php -S on separate ports)
WC_API_URL=http://127.0.0.1:8090
PW_BASE_URL=http://127.0.0.1:8092

# Production subdirectory example (navodispatch.com):
# WC_API_URL=https://navodispatch.com/wc/public
# PW_BASE_URL=https://navodispatch.com/pw/public
# If these still point at localhost, the app auto-detects the live host.
