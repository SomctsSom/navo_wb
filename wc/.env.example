APP_ENV=local
APP_NAME=Website Management System
APP_DEBUG=0
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Mogadishu

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wms_core
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Public base URLs for each application (no trailing slash)
WC_BASE_URL=http://127.0.0.1:8090
WA_BASE_URL=http://127.0.0.1:8091
PW_BASE_URL=http://127.0.0.1:8092

# Production subdirectory example:
# WC_BASE_URL=https://navodispatch.com/wc/public
# WA_BASE_URL=https://navodispatch.com/wa/public
# PW_BASE_URL=https://navodispatch.com/pw/public
# WC_API_URL=https://navodispatch.com/wc/public
# COOKIE_SECURE=1

# API base used by WA and PW (server-side HTTP client)
WC_API_URL=http://127.0.0.1:8090

SESSION_NAME=wms_session
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=_csrf
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
MENU_MAX_DEPTH=3

UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_WIDTH=4000
UPLOAD_MAX_HEIGHT=4000

COOKIE_SECURE=0
COOKIE_SAMESITE=Lax
